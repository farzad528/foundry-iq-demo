# Local UI/code preview needs no credentials; answers require configured live Azure backends.
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Production: exact approved App Service HTTPS origin; never derive it from Host.
# PUBLIC_ORIGIN=https://app-foundryiq-customer-demos.azurewebsites.net
AZURE_SEARCH_ENDPOINT=https://srch-foundryiq-customer-demos.search.windows.net
# App Service resolves Key Vault references; do not paste secrets in Git or chat.
AZURE_SEARCH_API_KEY=
SESSION_SECRET=
FOUNDRY_IQ_QUOTA_CONTAINER_URL=https://stfoundryiqcustomerdemos.blob.core.windows.net/demo-quotas
# Fail closed by default. Both this switch and quotas.json.enabled must be true.
FOUNDRY_IQ_LIVE_ENABLED=false
# Enable only after region/model compatibility and real contract verification.
FOUNDRY_IQ_MEDIUM_ENABLED=false
# Only on a verified App Service proxy path that appends the client IP.
FOUNDRY_IQ_TRUST_APP_SERVICE_PROXY=false
# Optional user-assigned managed identity client ID for quota-container access.
# AZURE_CLIENT_ID=
# Optional Python executable used at build time; never used by npm start.
# PYTHON=
