# Local replay: no Azure resources or credentials are required.
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Production: exact approved App Service HTTPS origin; never derive it from Host.
# PUBLIC_ORIGIN=https://app-foundryiq-customer-demos.azurewebsites.net
AZURE_SEARCH_ENDPOINT=https://foundry-iq-demos.search.windows.net
# App Service resolves Key Vault references; do not paste secrets in Git or chat.
AZURE_SEARCH_API_KEY=
SESSION_SECRET=
FOUNDRY_IQ_QUOTA_CONTAINER_URL=https://stfoundryiqcustomerdemos.blob.core.windows.net/demo-quotas
# Fail closed by default. Both this switch and quotas.json.enabled must be true.
FOUNDRY_IQ_LIVE_ENABLED=false
FOUNDRY_IQ_KILL_SWITCH=false
# Server-only versioned scenario allowlist (see README); never client supplied.
STUDIO_LIVE_CONFIG=
# Existing corpus/query text encoder; credentials stay server-only.
STUDIO_TEXT_ENDPOINT=
STUDIO_TEXT_API_KEY=
# entra requires an explicitly injected server token provider.
# Repository local operator injects AzureCliCredential; no production CLI fallback.
STUDIO_MODEL_AUTH=
# Same external answer model for both S07 arms; existing resource only.
STUDIO_ANSWER_ENDPOINT=
STUDIO_ANSWER_API_KEY=
# Compatible Azure Vision account; no automatic provisioning at runtime.
# Approved local binding: https://vision-foundry-iq-demos.cognitiveservices.azure.com
# Entra-only account uses injected getModelToken with STUDIO_MODEL_AUTH=entra; no key.
STUDIO_IMAGE_ENDPOINT=
STUDIO_IMAGE_API_KEY=
# Additional ingestion/cleanup require separate approval and explicit --apply.
STUDIO_INGEST_APPROVED=false
STUDIO_CLEANUP_APPROVED=false
# Enable only after region/model compatibility and real contract verification.
FOUNDRY_IQ_MEDIUM_ENABLED=false
# Only on a verified App Service proxy path that appends the client IP.
FOUNDRY_IQ_TRUST_APP_SERVICE_PROXY=false
# Optional user-assigned managed identity client ID for quota-container access.
# AZURE_CLIENT_ID=
# Optional Python executable used at build time; never used by npm start.
# PYTHON=
