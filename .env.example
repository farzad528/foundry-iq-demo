# Optional: copy to .env.local (ignored by Git). npm run build and npm start read it.
# Without any of these values, npm run dev serves the public Sample-only app (recorded Zava Sample, Live off).

# Live search (server-only; the query key is never sent to the browser). See docs/OPERATIONS.md.
LIVE_ENABLED=false
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_QUERY_KEY=
# Optional dedicated graph service for industry S08/S09.
AZURE_SEARCH_GRAPH_ENDPOINT=
AZURE_SEARCH_GRAPH_QUERY_KEY=
# Optional pause lists, for example S07,S11 or energy,healthcare.
LIVE_DISABLED_SCENARIOS=
LIVE_DISABLED_INDUSTRIES=

# Private build inputs (paths to files kept outside Git). Leave all unset for the public build.
STUDIO_PRIVATE_BINDINGS=
STUDIO_PRIVATE_ATTESTATIONS=
STUDIO_PRIVATE_GRAPH=
STUDIO_INDUSTRIES=
STUDIO_PRIVATE_INDUSTRIES=
STUDIO_PRIVATE_INDUSTRY_GRAPH=
STUDIO_PRIVATE_INDUSTRY_GRAPH_ATTESTATIONS=
