{
  "name": "foundryiq-customer-demos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "start:live": "node scripts/local-live.mjs --start",
    "pretest": "node scripts/build.mjs",
    "test": "node --test scripts/verify.mjs scripts/studio-tests.mjs scripts/studio-http-tests.mjs scripts/studio-language-tests.mjs scripts/vercel-tests.mjs",
    "test:browser": "node --test scripts/studio-browser-tests.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "studio:generate": "node scripts/generate-studio.mjs",
    "studio:provision": "node scripts/studio-provision.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/identity": "^4.12.0",
    "@azure/storage-blob": "^12.29.1"
  },
  "devDependencies": {
    "playwright": "^1.58.0"
  }
}
